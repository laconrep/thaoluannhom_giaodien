# ============================================================
# MẪU BIẾN MÔI TRƯỜNG — file này KHÔNG chứa giá trị thật
# Copy sang .env.local khi chạy local, hoặc dùng làm checklist
# khi điền tay trên v0.app (xem aideploy.md Bảng 2.1)
# ============================================================

# ===== BẮT BUỘC =====
# Lấy từ: Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Lấy từ: Supabase > Settings > API > anon publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-publishable-key>
# Lấy từ: Supabase > Settings > API > anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ===== SERVER / ADMIN (nên có) =====
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Bí mật, chỉ dùng ở server. Lấy từ: Supabase > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
# Bí danh (optional)
# SUPABASE_SERVICE_KEY=<service-role-secret-key>
# SUPABASE_SECRET_KEY=<service-role-secret-key>

# ===== TÙY CHỌN =====
# URL redirect sau khi đăng ký (nếu không set sẽ dùng fallback tự động)
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=https://<your-domain>/auth/callback
