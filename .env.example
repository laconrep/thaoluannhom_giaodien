# Copy thành .env.local để chạy dev: cp .env.example .env.local

# Supabase — bắt buộc (lấy từ Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Dùng phía server (API routes / server actions). Không bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Muse AI (tùy chọn) — chấm bài bằng Meta Model API thay vì qua khung chat.
# Không có key này thì app tự dùng luồng muse_chat (không cần key).
MUSE_MODEL_API_KEY=
# Model mặc định khi dùng key trên (có thể giữ nguyên).
MUSE_MODEL=muse-spark-1.3-contributor

# Dev: URL redirect sau khi đăng nhập (tùy chọn).
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000
